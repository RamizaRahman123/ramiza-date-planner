# Copy to .env and fill in:  cp .env.example .env
# Never commit .env - the repository is public.

# The passcode you both type to open the site
SITE_PASSCODE=choose-a-passcode-only-you-two-know

# Random secret for the login cookie (deploy.sh fills this in automatically)
SESSION_SECRET=

# Names shown on the site
HER_NAME=Ramiza
HIS_NAME=YourHusbandsName
